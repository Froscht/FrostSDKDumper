# ── Build output ─────────────────────────────────────────────────────────
FrostDumper
FrostDumper_*
build/
*.o
*.obj
*.a
*.so
*.d

# Kernel module build artifacts. build_and_run.sh rebuilds these; the .cmd
# and .mod files carry absolute paths from whichever machine built them.
*.ko
*.mod
*.mod.c
.*.cmd
modules.order
Module.symvers

# One-off probe binaries. Sources stay tracked, binaries do not.
probe_*
!probe_*.cpp
!probe_*.py
tools/extract_vtables_offline

# ── Dumper output ────────────────────────────────────────────────────────
SDK_Output.txt
SDK_Output.h
SDK_Output_OLD.txt
SDK.hpp
dump_*.txt
vtable_map.md
generated_decrypt.h
static_reflect.txt

# The live constant snapshot. Regenerated every run and patch-specific, so
# committing it means the next patch loads stale values — see the config
# hygiene notes in CLAUDE.md.
decrypt_export.json
decrypt_export.json.*
decrypt_export_*.json*

# ── Reverse-engineering artifacts ────────────────────────────────────────
# Module dumps are hundreds of MB and specific to one build.
*.bin
*.exe
*.dll
*.pdb
module_dump_*

# IDA / Ghidra
*.i64
*.idb
*.id0
*.id1
*.id2
*.nam
*.til
*.asm
ida_decomp/

# Reference SDKs and archives
/SDK
/sdk
refSDK/
*.zip
*.7z
*.tar.gz

# ── Tooling and environment ──────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/

.mcp.json
/.claude
.vscode/
.idea/
compile_commands.json

